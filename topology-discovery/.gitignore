# Python environment created by scripts/setup_env.sh
.venv/
__pycache__/
*.pyc

# Discovery runs. Each run is a full directory including raw NETCONF XML,
# which is large and grows without bound. The latest published documents are
# committed under topology/ instead.
#
# To keep a specific run as a reference, force-add it:
#   git add -f results/20260914-120000
results/*
!results/.gitkeep

# Exact dependency versions, recorded per-machine when a run must be
# reproducible. Not committed: it is machine- and Python-version-specific.
requirements.lock
