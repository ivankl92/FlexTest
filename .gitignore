# ===========================================================================
# One ignore file for the whole repository.
#
# Consolidated from the former per-subproject .gitignore files. Two kinds of
# pattern live here and the difference matters:
#
#   * Patterns containing a slash are anchored to this file's directory, so
#     /i226-adaptation/results/ ignores exactly that folder and nothing with
#     a similar name elsewhere in the tree.
#   * Patterns without a slash (__pycache__/, *.pyc, .venv/) match at any
#     depth and therefore apply to every subproject automatically.
#
# Add new subproject rules here, anchored, rather than starting a new
# .gitignore inside the subproject.
# ===========================================================================

# --- Editors and IDEs ------------------------------------------------------
.idea/

# --- Python ----------------------------------------------------------------
# .venv/ must be listed here: a virtualenv ships its own .gitignore
# containing "*", so the root .venv/ was previously self-hiding rather than
# ignored by the repository. If that file is ever removed or the environment
# is created another way, this line is what keeps it out.
.venv/
__pycache__/
*.pyc

# Exact dependency versions, recorded per-machine when a run must be
# reproducible. Machine- and Python-version-specific, so not committed.
requirements.lock

# --- i226-adaptation -------------------------------------------------------
# Measurement output. Large (~200 MB per campaign), machine-specific, and
# regenerated by every run — not source. RESULT_ROOT in scripts/config.conf
# points here, and the campaign runs under sudo, so these land root-owned.
/i226-adaptation/results/

# Build products. setup_node.sh compiles into /opt/tsn-flextest/, but a manual
# `gcc -o tsn_tx tools/tsn_tx.c` leaves binaries in the tree.
/i226-adaptation/tools/tsn_tx
/i226-adaptation/tools/tsn_rx

# --- topology-discovery ----------------------------------------------------
# Discovery runs. Each run is a full directory including raw NETCONF XML,
# which is large and grows without bound. The latest published documents are
# committed under topology-discovery/topology/ instead.
#
# To keep a specific run as a reference, force-add it:
#   git add -f topology-discovery/results/20260914-120000
/topology-discovery/results/*
!/topology-discovery/results/.gitkeep

# Synthetic fixture output from tests/make_fixture.py: fabricated data,
# regenerated on demand, and never a property of the testbed.
/topology-discovery/tests/results/
