# Measurement output. Large (~200 MB per campaign), machine-specific, and
# regenerated by every run — not source. RESULT_ROOT in scripts/config.conf
# points here, and the campaign runs under sudo, so these land root-owned.
i226-adaptation/results/

# Build products. setup_node.sh compiles into /opt/tsn-flextest/, but a manual
# `gcc -o tsn_tx tools/tsn_tx.c` leaves binaries in the tree.
i226-adaptation/tools/tsn_tx
i226-adaptation/tools/tsn_rx

__pycache__/
*.pyc
